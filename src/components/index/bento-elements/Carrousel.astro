---
const images = [
  { path: "images/habilities/HTML5.png", alt: "Html" },
  { path: "images/habilities/CSS3.png", alt: "CSS3" },
  { path: "images/habilities/JavaScript.png", alt: "JavaScript" },
  { path: "images/habilities/TypeScript.png", alt: "TypeScript" },
  { path: "images/habilities/Astro.png", alt: "Astro" },
  { path: "images/habilities/React.png", alt: "React" },
  { path: "images/habilities/TailwindCSS.png", alt: "Tailwind CSS" },
  { path: "images/habilities/MySQL.png", alt: "Tailwind CSS" },
  { path: "images/habilities/Node.js.png", alt: "Tailwind CSS" },
  { path: "images/habilities/VSCode.png", alt: "Tailwind CSS" },
  { path: "images/habilities/Insomnia.png", alt: "Tailwind CSS" },
];

const allImages = [...images, ...images];
const animationSpeed = "30s";
---

<div class="slider">
  <div
    class="slide-track"
    style={`animation: scroll ${animationSpeed} linear infinite;`}
  >
    {
      allImages.map((image) => (
        <div class="slide">
          <img class="logo" src={image.path} alt={`Logo ${image.alt}`} />
        </div>
      ))
    }
  </div>
</div>

<style>
  .slider {
    height: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
  }

  .logo {
    height: 100%;
    filter: drop-shadow(0 0 0.25rem var(--transparent));
    content: "";
    height: 100%;
  }

  .slider::before,
  .slider::after {
    content: "";
    position: absolute;
    width: 250px;
    height: 100%;
    top: 0;
    z-index: 2;
    background: linear-gradient(to right, var(--bg) 15%, #00000000 90%);
  }

  .slider::after {
    right: -1px;
    transform: rotateZ(180deg);
  }

  .slider::before {
    left: -1px;
  }

  .slide-track {
    display: flex;
    padding: 8px 0px;
    width: calc(90px * 14);
    animation: scroll linear infinite;
  }

  .slide {
    width: 90px;
    height: 40px;
    flex-shrink: 0;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-90px * 11));
    }
  }
</style>
